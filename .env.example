# ─────────────────────────────────────────────────────────────────────────────
# Marketing Intelligence & Management Dashboard — environment variables
# Copy to `.env` (local / PM2) or `.env.production` / `.env.staging` (Docker) and fill in.
# NEVER commit real values. Every variable is documented in docs/deployment-hostinger.md.
# ─────────────────────────────────────────────────────────────────────────────

# ── Runtime ──────────────────────────────────────────────────────────────────
# development | production  (production enables Secure cookies and strict CSP)
NODE_ENV=development
# debug | info | warn | error — structured JSON logs to stdout (src/lib/logger.ts)
LOG_LEVEL=info

# ── Core (REQUIRED) ──────────────────────────────────────────────────────────
# PostgreSQL 14+ connection string. For Docker Compose the host is `db`.
# Managed providers (Neon / Supabase) usually need `?sslmode=require`.
DATABASE_URL=postgresql://mimd:change-me@localhost:5432/mimd?schema=public

# 32 random bytes, base64. Encrypts OAuth tokens + TOTP secrets (AES-256-GCM, src/lib/crypto.ts).
# Generate: openssl rand -base64 32
# Losing or changing this key makes stored tokens unreadable — back it up separately from the DB.
ENCRYPTION_KEY=

# Public base URL, no trailing slash. Used in e-mails, share links (/r/<token>) and
# OAuth redirect URIs: ${APP_URL}/api/oauth/<platform>/callback
APP_URL=http://localhost:3000

# ── Branding / i18n ──────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_NAME="Marketing Intelligence"
# ar | en — language shown before a user picks one
DEFAULT_LOCALE=ar

# ── Docker Compose / Caddy only ──────────────────────────────────────────────
# Domain Caddy requests a Let's Encrypt certificate for (DNS A record must point to the VPS).
DOMAIN=dashboard.example.com
ACME_EMAIL=ops@example.com
# Credentials of the bundled postgres:16 container (must match DATABASE_URL).
POSTGRES_USER=mimd
POSTGRES_PASSWORD=change-me
POSTGRES_DB=mimd

# ── E-mail (optional; without SMTP_HOST mails are only logged) ───────────────
# Hostinger mail: smtp.hostinger.com, port 465 (SSL). Port 587 uses STARTTLS.
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM="Marketing Intelligence <no-reply@example.com>"

# ── Files & backups ──────────────────────────────────────────────────────────
# Where /api/uploads stores files (must be writable and backed up).
UPLOAD_DIR=./uploads
# Where scripts/backup.sh writes dumps.
BACKUP_DIR=./backups
# Days of daily dumps to keep; weekly (Sunday) dumps kept for BACKUP_KEEP_WEEKLY weeks.
BACKUP_RETENTION_DAYS=14
BACKUP_KEEP_WEEKLY=8
# Optional off-site copy via rclone, e.g. "b2:mimd-backups" or "gdrive:backups/mimd". Empty = disabled.
RCLONE_REMOTE=

# ── Background jobs ──────────────────────────────────────────────────────────
# Shared secret for /api/cron/* (used when no worker process can run, e.g. Hostinger Node.js hosting).
# Generate: openssl rand -hex 32
CRON_SECRET=

# ── AI (optional) ────────────────────────────────────────────────────────────
# Without a key the rule-based engine (src/lib/ai/insights.ts) is used and AI buttons are hidden.
ANTHROPIC_API_KEY=
# Model id used by src/lib/ai/claude.ts (default claude-opus-5-5).
AI_MODEL=claude-opus-5-5

# ── Integrations (optional; each platform is disabled until its vars are set) ─
# See docs/integrations-setup.md for how to create each app and the exact scopes.

# Meta (Facebook / Instagram / Marketing API) — developers.facebook.com
META_APP_ID=
META_APP_SECRET=
# Long-lived token of a verified identity for the Ad Library API (competitor ads).
META_AD_LIBRARY_TOKEN=

# Google (Ads, GA4, Search Console, YouTube) — console.cloud.google.com
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Google Ads API developer token (Ads UI → Tools → API Center). Basic access required for production.
GOOGLE_ADS_DEVELOPER_TOKEN=
# Manager (MCC) customer id without dashes, when accounts are accessed through an MCC.
GOOGLE_ADS_LOGIN_CUSTOMER_ID=

# TikTok for Business (Marketing API) — business-api.tiktok.com
TIKTOK_APP_ID=
TIKTOK_APP_SECRET=

# LinkedIn (Marketing Developer Platform) — linkedin.com/developers
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=

# X (Twitter) API v2 — developer.x.com (paid tier required for most read endpoints)
X_CLIENT_ID=
X_CLIENT_SECRET=

# ── Monitoring (optional) ────────────────────────────────────────────────────
# Sentry DSN; empty = disabled. Errors are always logged as JSON to stdout.
SENTRY_DSN=
