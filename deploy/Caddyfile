# Caddy reverse proxy with automatic HTTPS (Let's Encrypt).
# DOMAIN and ACME_EMAIL come from the environment (docker-compose.yml → caddy service).
# The DNS A/AAAA record for DOMAIN must point to this server and ports 80/443 must be open.

{
	email {$ACME_EMAIL}
	# Uncomment while testing to avoid Let's Encrypt rate limits:
	# acme_ca https://acme-staging-v02.api.letsencrypt.org/directory
}

{$DOMAIN} {
	encode zstd gzip

	# Uploads are limited in the app too; this is the outer bound.
	request_body {
		max_size 30MB
	}

	# Long-lived caching for hashed Next.js assets.
	@static path /_next/static/*
	header @static Cache-Control "public, max-age=31536000, immutable"

	header {
		-Server
		# HSTS/CSP/X-Frame-Options are set by the app (next.config.ts); keep proxy headers minimal.
	}

	reverse_proxy app:3000 {
		header_up X-Forwarded-Proto {scheme}
		header_up X-Real-IP {remote_host}
		health_uri /api/health
		health_interval 30s
	}

	log {
		output stdout
		format json
	}
}

# Redirect www → apex (optional; add a DNS record for www first).
# www.{$DOMAIN} {
# 	redir https://{$DOMAIN}{uri} permanent
# }
